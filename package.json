{
  "name": "antifraud",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:root && npm run build --workspaces --if-present",
    "build:root": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:scenario-catalog": "npm run test -w @deepcode/antifraud-scenario-catalog",
    "scenarios:validate": "npm run build -w @deepcode/antifraud-scenario-catalog && node scripts/validate-scenarios.cjs"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "vitest": "^4.1.6"
  },
  "private": true
}
